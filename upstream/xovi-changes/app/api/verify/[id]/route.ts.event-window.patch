+/**
+ * Who actually answers for this clip.
+ *
+ * For a human submission that is the submitter. For a machine proposal it is the
+ * HOLDER of the credential that made it, never the agent's own address: the agent
+ * has a fresh keypair its operator generated, so comparing that address is exactly
+ * what delegation defeats, and it costs nothing to defeat.
+ *
+ * Returns null when the responsible human cannot be determined, and every caller
+ * treats that as a refusal. Writing it the obvious way instead — look up, compare,
+ * done — evaluates false on a null and PERMITS the confirmation it exists to block.
+ */
+async function responsibleHumanFor(clip: {
+  submitterAddress: string;
+  ingestKeyId: number | null;
+}): Promise<string | null> {
+  if (clip.ingestKeyId === null) return clip.submitterAddress;
+  return await holderOfKey(clip.ingestKeyId);
+}
+
+/** Refusal response, or null when the reviewer is clear to act. */
+async function selfReviewRefusal(
+  clip: { submitterAddress: string; ingestKeyId: number | null },
+  reviewer: string,
+  verb: string,
+): Promise<NextResponse | null> {
+  const responsible = await responsibleHumanFor(clip);
+  if (responsible === null) {
+    // Fail closed. A machine row whose credential is revoked or holderless has no
+    // resolvable human, and "we could not tell" is not permission.
+    return NextResponse.json({ error: "No se puede determinar quién responde por este clip" }, { status: 403 });
+  }
+  // Lowercased compare: both are checksummed in normal flow, but lowercasing avoids
+  // a getAddress() throw (→500) on any malformed legacy row turning the guard into
+  // a crash, which fails open in a different way.
+  if (responsible.toLowerCase() === reviewer.toLowerCase()) {
+    return NextResponse.json({ error: `No puedes ${verb} tu propio clip` }, { status: 403 });
+  }
+  return null;
+}
