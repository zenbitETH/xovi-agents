# Recipient of every settled payment. Published in plain sight in each 402
# challenge, so it is an advertised address with a public balance: give it its own
# key, and never the key that controls a name or a treasury.
# Unset, the route answers 503. It does not become free.
X402_PAY_TO=

# CAIP-2 network. Base Sepolia by default. There is no localhost option because a
# facilitator cannot verify or settle against a local chain.
X402_NETWORK=eip155:84532

# The testnet facilitator is free and needs no signup.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Price per read. Dollar syntax means USDC.
X402_PRICE=$0.01

# Path to the window snapshot this endpoint serves. A COPY, never the detector's
# live output directory, which its own harness rewrites. Unset, the route answers
# 503 rather than an empty list: an empty list means the detector found nothing,
# which is a real answer, and a missing path means nobody configured this.
WINDOWS_SNAPSHOT=fixtures/windows.synthetic.jsonl

# Comma separated aliases that must not leave the building. Read at runtime and
# never committed: the list is specimen data, and writing it into this repository
# would publish the thing it protects. A window touching any of these is dropped
# whole rather than redacted.
EMBARGOED_ALIASES=

# The agent's own key. It pays for reads and signs nothing else, and EIP-3009 signing
# touches no chain, so it needs an RPC for nothing. Its address is also what --agent
# stamps on the ingest credential, which makes it an attribution identity as well as a
# spending key. It must never be the address in X402_PAY_TO: a payment from an address
# to itself settles without complaint, proves nothing, and puts two identical addresses
# in the one screenshot a demo needs most.
AGENT_PRIVATE_KEY=

# Ceiling per payment. The library default is a dollar and a window costs a cent, so
# this is never reached. It is set anyway, because the price arrives from the server in
# the challenge and a client that pays whatever it is told is one typo from paying it.
AGENT_MAX_PER_PAYMENT=$0.05

# The paid window endpoint. Used only when AGENT_ENS_NAME is unset: setting a name
# does not make this a fallback, it makes this unused, because a name that resolves
# to nothing is not permission to read from somewhere else.
WINDOWS_URL=

# An ENS name whose x402:windows record holds the endpoint. Optional. When set, the
# record is read at every run and must name an https url, so the operator can move
# the endpoint without shipping the agent again. Nothing is registered yet.
AGENT_ENS_NAME=
AGENT_ENS_RPC_URL=

# Where the agent proposes clips, and the credential it proposes with. The key is a
# bearer, so it is sent in a header on every request: this url must be https, or the
# credential travels in clear text to whoever is listening. The key is shown once at
# mint time and cannot be recovered.
XOVI_INGEST_URL=
XOVI_INGEST_KEY=

# Windows a person has already refused, so the agent stops asking. Defaults to
# .agent-ledger.json in the working directory. It quotes the refusal text the server
# returned, so it is gitignored rather than committed.
AGENT_LEDGER=

# The proof of human registry, and the chain it is read on. Read World Chain, chain
# 480, because that is the only chain the registration tool writes: the published
# version rejects a network flag whatever its README says. The same contract is
# deployed at the same address on Base Sepolia with separate state, so pointing this
# at the payment chain returns zero for every agent, the cap fails closed and every
# read settles while looking exactly like a world where nobody registered.
#
# Note what that means: payments settle on Base Sepolia and this read happens on a
# mainnet. It moves nothing, holds nothing and needs no key, but the narration must
# not say testnet without qualifying it.
AGENTBOOK_ADDRESS=
AGENTBOOK_RPC_URL=

# Free reads per verified human per UTC day. Twenty by default. Zero is a valid
# count rather than a missing one, and it is the switch that lets the paid read be
# demonstrated by a payer who is registered: with the cap at zero their reads settle
# and produce the explorer transaction the paid leg needs.
HUMAN_FREE_READS_PER_DAY=

# Where the count and the receipts live. Unset, there is no allowance and every read
# settles, which is what this endpoint did before the cap existed. That is the
# correct degradation and not a stub, and it means the free path cannot be shown
# until this is set.
DATABASE_URL=

# Server secret used to derive what the usage table stores, so that a copy of that
# table on its own cannot be matched against on chain registrations. Thirty two
# random bytes as hex. It is a secret held outside this repository and it is never
# committed: losing it orphans the counters and nothing else, since nothing else is
# keyed on it and the underlying value stays readable on chain either way.
# Unset, there is no derivation, so there is no allowance and every read settles.
HUMAN_ID_KEY=
