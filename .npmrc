# A version has to be a week old before npm will resolve it. The October 2026 worm
# (tensorlake 0.5.144) and the August wave before it were each pulled within hours
# of publishing; a week is longer than any of them stayed up. Needs npm >= 11.10,
# which Node 24.22.1 ships. Dependabot's cooldown sits one day above this.
min-release-age=7
